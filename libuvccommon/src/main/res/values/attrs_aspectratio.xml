<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- アスペクト比, 負なら未設定 -->
    <attr name="aspect_ratio" default="-1.0" format="float" />
    <!-- スケールの種類 -->
    <attr name="scale_mode" default="scale_none">
        <enum name="keep_aspect" value="0" />
        <enum name="stretch_to_fit" value="1" />
        <enum name="crop_center" value="2" />
    </attr>
    <!-- タッチ操作による回転拡大縮小を有効にするかどうか -->
    <attr name="handle_touch_event" default="true" format="boolean" />

    <!-- =========================================================================== -->

    <declare-styleable name="IAspectRatioView">
        <attr name="aspect_ratio" />
    </declare-styleable>

    <declare-styleable name="IScaledView">
        <attr name="scale_mode" />
    </declare-styleable>

    <declare-styleable name="AspectScaledTextureView">
        <attr name="aspect_ratio" />
        <attr name="scale_mode" />
    </declare-styleable>

    <declare-styleable name="ZoomAspectScaledTextureView">
        <attr name="aspect_ratio" />
        <attr name="scale_mode" />
        <attr name="handle_touch_event" />
    </declare-styleable>
</resources>