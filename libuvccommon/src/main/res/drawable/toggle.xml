<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false">
        <layer-list>
            <item android:drawable="@drawable/toggle_button_base" />
            <item android:right="64dp">
                <shape android:innerRadius="0dp" android:shape="ring" android:thickness="8dp" android:useLevel="false">
                    <gradient android:endColor="#3F333333" android:gradientRadius="10" android:startColor="#3F666666" android:type="radial" />
                    <stroke android:width="1dp" android:color="#3F666666" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item android:drawable="@drawable/toggle_button_base" />
            <item android:right="64dp">
                <shape android:innerRadius="0dp" android:shape="ring" android:thickness="8dp" android:useLevel="false">
                    <gradient android:endColor="#3F006600" android:gradientRadius="10" android:startColor="#3F00FF00" android:type="radial" />
                    <stroke android:width="1dp" android:color="#3F666666" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>