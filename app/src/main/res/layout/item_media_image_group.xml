<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/mediaImageGroupItemIv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:contentDescription="@string/mediaImageGroup"
        tools:ignore="InefficientWeight" />

    <TextView
        android:id="@+id/mediaImageGroupItemTvFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_6"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/sp_12"
        tools:text="目录" />

    <TextView
        android:id="@+id/mediaImageGroupItemTvCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="@dimen/sp_12"
        tools:text="数量" />
</LinearLayout>